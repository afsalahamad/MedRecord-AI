# Rename this file to .env and fill in your values

# Get a free API key (no credit card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Local dev default: sqlite (zero setup). For Postgres, use a Neon/Supabase URL:
# postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./medrecord.db

# Model to use for extraction / chat. gemini-2.5-flash is the free-tier
# default (10 requests/minute on the free tier as of this writing) and
# supports vision + PDF understanding + structured JSON output.
GEMINI_MODEL=gemini-2.5-flash
