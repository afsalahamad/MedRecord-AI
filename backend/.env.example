# ============================================================
# MedRecord AI -- Production Backend Environment Template (.env.example)
# ============================================================

# Live Supabase Session Pooler PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Live Supabase API & Storage Credentials
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=sb_secret_[your-supabase-secret-key]
SUPABASE_STORAGE_BUCKET=medical-reports

# Google Gemini AI API Configuration
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-flash-latest

# Production Server Port & CORS
PORT=8000
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
